@namespace DocAnalyzerAI.Components.Audit

<div class="card card-executive p-4">
    <h4 class="heading-serif fw-bold mb-3 d-flex align-items-center gap-2">
        <i class="bi bi-file-earmark-text text-warning"></i> Resumen Ejecutivo del Documento
    </h4>
    <div class="lh-lg fs-6" style="white-space: pre-line; color: var(--text-secondary);">
        @Summary
    </div>
</div>

@code {
    [Parameter] public string Summary { get; set; } = string.Empty;
}
