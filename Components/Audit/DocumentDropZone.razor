@namespace DocAnalyzerAI.Components.Audit
@inject IJSRuntime JS

<!-- InputFile SIEMPRE se mantiene en el DOM para que Blazor pueda transmitir el flujo de bytes sin errores -->
<InputFile id="fileUploadInput" 
           OnChange="OnFileSelected" 
           accept=".pdf,.docx"
           style="display: none;" />

@if (SelectedFile == null)
{
    <div id="dropzoneArea" class="dropzone-container" onclick="document.getElementById('fileUploadInput').click();">
        <div class="dropzone-content">
            <div class="dropzone-icon">
                <i class="bi bi-cloud-arrow-up-fill"></i>
            </div>
            <h4 class="fw-bold mb-2">Arrastra tu contrato aquí o haz clic para seleccionarlo</h4>
            <p class="text-muted mb-3">Compatible con documentos legales en formato PDF y Microsoft Word (.docx)</p>
            
            <button type="button" class="btn btn-browse px-4 py-2 rounded-pill fw-semibold" onclick="document.getElementById('fileUploadInput').click();">
                <i class="bi bi-folder2-open me-2"></i>Examinar archivo
            </button>
        </div>
    </div>
}
else
{
    <div class="selected-file-panel">
        <!-- Lado izquierdo: Icono de documento y metadatos -->
        <div class="file-info-group">
            <div class="file-badge @(IsPdf(SelectedFile.Name) ? "pdf-badge" : "word-badge")">
                <i class="bi @(IsPdf(SelectedFile.Name) ? "bi-file-earmark-pdf-fill" : "bi-file-earmark-word-fill")"></i>
            </div>
            <div class="file-text-meta">
                <h5 class="fw-bold mb-1 file-name-heading text-truncate" title="@SelectedFile.Name">
                    @SelectedFile.Name
                </h5>
                <div class="file-pills-row">
                    <span class="badge file-meta-badge">
                        <i class="bi bi-hdd-fill me-1 text-muted"></i>@FormatFileSize(SelectedFile.Size)
                    </span>
                    <span class="badge file-format-badge">
                        <i class="bi @(IsPdf(SelectedFile.Name) ? "bi-filetype-pdf" : "bi-filetype-docx") me-1"></i>
                        @(IsPdf(SelectedFile.Name) ? "PDF" : "DOCX")
                    </span>
                    <span class="badge file-status-badge">
                        <i class="bi bi-check-circle-fill me-1 text-success"></i>Listo para dictamen
                    </span>
                </div>
            </div>
        </div>

        <!-- Lado derecho: Acciones alineadas a la derecha -->
        <div class="file-actions-group">
            <button class="btn btn-change-doc px-3 py-2 fw-semibold" 
                    @onclick="OnClearFile" 
                    disabled="@IsProcessing"
                    title="Cargar un documento diferente">
                <i class="bi bi-arrow-left-right me-1"></i>Cambiar archivo
            </button>
            <button class="btn btn-gold-action px-4 py-2 fw-bold" 
                    @onclick="OnStartAudit" 
                    disabled="@IsProcessing">
                <i class="bi bi-shield-check me-2"></i>Iniciar Análisis
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public IBrowserFile? SelectedFile { get; set; }
    [Parameter] public EventCallback<InputFileChangeEventArgs> OnFileSelected { get; set; }
    [Parameter] public EventCallback OnClearFile { get; set; }
    [Parameter] public EventCallback OnStartAudit { get; set; }
    [Parameter] public bool IsProcessing { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (SelectedFile == null && !IsProcessing)
        {
            try
            {
                await JS.InvokeVoidAsync("docAnalyzer.initDropZoneById", "dropzoneArea", "fileUploadInput");
            }
            catch { }
        }
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes >= 1024 * 1024)
            return $"{bytes / 1024.0 / 1024.0:F2} MB";
        return $"{bytes / 1024.0:F1} KB";
    }

    private static bool IsPdf(string fileName)
    {
        return Path.GetExtension(fileName).Equals(".pdf", StringComparison.OrdinalIgnoreCase);
    }
}
