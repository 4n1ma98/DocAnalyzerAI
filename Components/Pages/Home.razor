@page "/"
@rendermode InteractiveServer
@inject IDocumentReaderService DocumentReader
@inject IGeminiAuditService GeminiService

<PageTitle>DocAnalyzer AI - Auditoría Legal de Contratos</PageTitle>

<div class="container-fluid pb-5">
    <!-- Hero Header -->
    <div class="doc-header-card p-4 p-md-5 mb-4">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge badge-gold px-3 py-1 mb-2">
                    <i class="bi bi-bank2 me-1"></i> DICTAMEN JURÍDICO ASISTIDO
                </span>
                <h1 class="display-6 heading-serif fw-bold mb-2">Auditoría Crítica de Contratos &amp; Acuerdos</h1>
                <p class="lead mb-0 text-white-50">
                    Sube cualquier contrato en formato <strong>PDF</strong> o <strong>Word (.docx)</strong>. Nuestro motor impulsado por Google Gemini extraerá cláusulas críticas, detectará asimetrías y generará contrapropuestas de negociación bajo jurisprudencia vigente.
                </p>
            </div>
            <div class="col-lg-4 text-center text-lg-end mt-4 mt-lg-0">
                <div class="d-inline-flex flex-column align-items-center bg-white bg-opacity-10 rounded-4 p-3 border border-white border-opacity-25">
                    <i class="bi bi-file-earmark-check-fill text-warning fs-1 mb-1"></i>
                    <span class="fw-bold small text-uppercase tracking-wider">Formatos Admitidos</span>
                    <span class="badge bg-white text-dark mt-1">PDF &amp; DOCX (Máx. 15 MB)</span>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-start gap-2 shadow-sm" role="alert">
            <i class="bi bi-exclamation-octagon-fill fs-5 mt-1 flex-shrink-0"></i>
            <div>
                <strong>Error en el proceso:</strong>
                <p class="mb-0 mt-1">@ErrorMessage</p>
            </div>
            <button type="button" class="btn-close ms-auto" @onclick="() => ErrorMessage = null" aria-label="Close"></button>
        </div>
    }

    <!-- Barra de Configuración de Jurisdicción y Perspectiva -->
    <div class="row justify-content-center @(AnalysisData != null || IsProcessing ? "d-none" : "")">
        <div class="col-xl-9">
            <AuditConfigurationBar Options="@AuditConfig"
                                   OptionsChanged="OnAuditConfigChanged"
                                   IsDisabled="@IsProcessing" />
        </div>
    </div>

    <!-- Panel de Carga / Input Modular (Permanece en el DOM para streaming de archivo pero se oculta con CSS) -->
    <div class="row justify-content-center @(AnalysisData != null || IsProcessing ? "d-none" : "")">
        <div class="col-xl-9">
            <DocumentDropZone SelectedFile="@SelectedFile"
                              Annexes="@AuditConfig.Annexes"
                              OnFileSelected="HandleFileSelected"
                              OnAnnexSelected="HandlePreAuditAnnexSelected"
                              OnRemoveAnnex="HandleRemoveAnnex"
                              OnClearFile="ClearSelectedFile"
                              OnStartAudit="StartAuditAsync"
                              IsProcessing="@IsProcessing" />
        </div>
    </div>

    <!-- Estado de Procesamiento Activo Modular -->
    @if (IsProcessing)
    {
        <AuditProgressIndicator StatusMessage="@ProcessingStatusMessage"
                                Progress="@ProcessingProgress"
                                ElapsedSeconds="@ElapsedSeconds" />
    }

    <!-- Dashboard de Resultados Modular -->
    @if (AnalysisData != null && !IsProcessing)
    {
        <!-- Header del Reporte -->
        <div class="card card-executive p-4 mb-4">
            <div class="row align-items-center">
                <div class="col-lg-8 col-md-7">
                    <div class="d-flex flex-wrap align-items-center gap-2 small mb-2">
                        <span class="badge badge-gold px-2 py-1">
                            <i class="bi bi-briefcase-fill me-1"></i> @AnalysisData.DetectedContractType
                        </span>
                        <span class="badge bg-secondary-subtle text-secondary px-2 py-1">
                            <i class="bi bi-geo-alt-fill me-1"></i> @AnalysisData.ApplicableJurisdiction
                        </span>
                        <span class="badge bg-primary-subtle text-primary px-2 py-1">
                            <i class="bi bi-person-bounding-box me-1"></i> @(AuditConfig.Perspective == AuditPerspective.Worker ? "Defensa: Trabajador" : "Blindaje: Empresa")
                        </span>
                        @if (AnalysisData.AnalyzedAnnexes.Count > 0)
                        {
                            <span class="badge bg-warning-subtle text-warning-emphasis px-2 py-1 border border-warning-subtle">
                                <i class="bi bi-paperclip me-1"></i> +@AnalysisData.AnalyzedAnnexes.Count Otro Sí / Anexo(s)
                            </span>
                        }
                    </div>
                    <h2 class="h3 heading-serif fw-bold mb-1">@AuditFileName</h2>
                    <p class="text-muted mb-0 small">
                        Analizado por Google Gemini &bull; Clasificación de cláusulas y semáforo de riesgo contractual
                    </p>
                </div>
                <RiskScoreGauge Score="@AnalysisData.RiskScore" OnReset="ResetAnalysis" />
            </div>
        </div>

        <!-- Matriz de Sub-Puntajes de Riesgo Ponderados -->
        <RiskSubScoresMatrix SubScores="@AnalysisData.SubScores" GlobalScore="@AnalysisData.RiskScore" />

        <!-- Sección de Incorporación de Otro Sí / Anexos Posteriores -->
        <AnnexUploadSection AnalysisData="@AnalysisData"
                            CurrentAnnexes="@AuditConfig.Annexes"
                            PendingAnnexFile="@PendingPostAuditAnnexFile"
                            OnPostAuditAnnexSelected="HandlePostAuditAnnexSelected"
                            OnAuditAnnexImpact="AuditPostAuditAnnexImpactAsync"
                            OnDiscardPendingAnnex="DiscardPendingPostAuditAnnex"
                            IsProcessing="@IsProcessing" />

        <!-- Navegación por Tabs -->
        <ul class="nav nav-pills nav-pills-custom mb-4 gap-2 border-bottom pb-3">
            <li class="nav-item">
                <button class="nav-link @(ActiveTab == "summary" ? "active" : "")" @onclick='() => ActiveTab = "summary"'>
                    <i class="bi bi-file-text me-2"></i>Resumen Ejecutivo
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(ActiveTab == "strengths" ? "active" : "")" @onclick='() => ActiveTab = "strengths"'>
                    <i class="bi bi-shield-check me-2 text-success"></i>Puntos Fuertes
                    <span class="badge bg-success-subtle text-success ms-2">@AnalysisData.Strengths.Count</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(ActiveTab == "weaknesses" ? "active" : "")" @onclick='() => ActiveTab = "weaknesses"'>
                    <i class="bi bi-exclamation-triangle me-2 text-warning"></i>Puntos Débiles
                    <span class="badge bg-warning-subtle text-warning ms-2">@AnalysisData.Weaknesses.Count</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(ActiveTab == "redflags" ? "active" : "")" @onclick='() => ActiveTab = "redflags"'>
                    <i class="bi bi-flag-fill me-2 text-danger"></i>Red Flags
                    <span class="badge bg-danger-subtle text-danger ms-2">@AnalysisData.RedFlags.Count</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(ActiveTab == "negotiation" ? "active" : "")" @onclick='() => ActiveTab = "negotiation"'>
                    <i class="bi bi-chat-quote-fill me-2 text-primary"></i>Mesa de Negociación
                    <span class="badge bg-primary-subtle text-primary ms-2">@AnalysisData.NegotiationSuggestions.Count</span>
                </button>
            </li>
        </ul>

        <!-- Contenido de las Secciones / Tabs Modulares -->
        <div class="tab-content">
            @if (ActiveTab == "summary")
            {
                <ExecutiveSummaryTab Summary="@AnalysisData.DocumentSummary" />
            }
            @if (ActiveTab == "strengths")
            {
                <StrengthsTab Items="@AnalysisData.Strengths" />
            }
            @if (ActiveTab == "weaknesses")
            {
                <WeaknessesTab Items="@AnalysisData.Weaknesses" />
            }
            @if (ActiveTab == "redflags")
            {
                <RedFlagsTab Items="@AnalysisData.RedFlags" />
            }
            @if (ActiveTab == "negotiation")
            {
                <NegotiationTableTab Suggestions="@AnalysisData.NegotiationSuggestions" />
            }
        </div>
    }
</div>

@code {
    private IBrowserFile? SelectedFile;
    private string? OriginalContractText;
    private IBrowserFile? PendingPostAuditAnnexFile;
    private string? ErrorMessage;
    private bool IsProcessing;
    private string ProcessingStatusMessage = string.Empty;
    private int ProcessingProgress = 0;
    private int ElapsedSeconds = 0;

    private AnalysisResult? AnalysisData;
    private string? AuditFileName;
    private string ActiveTab = "summary";

    private AuditOptions AuditConfig = new();

    private void OnAuditConfigChanged(AuditOptions options)
    {
        AuditConfig = options;
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        ErrorMessage = null;
        var file = e.File;
        if (file != null)
        {
            ValidateAndSetFile(file);
        }
    }

    private async Task HandlePreAuditAnnexSelected(InputFileChangeEventArgs e)
    {
        ErrorMessage = null;
        var file = e.File;
        if (file == null) return;

        try
        {
            ValidateFileFormat(file);
            var annexText = await DocumentReader.ExtractTextAsync(file);
            AuditConfig.Annexes.Add(new ContractAnnexItem
            {
                FileName = file.Name,
                Size = file.Size,
                Text = annexText
            });
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error al adjuntar anexo: {ex.Message}";
        }
    }

    private void HandleRemoveAnnex(ContractAnnexItem annex)
    {
        AuditConfig.Annexes.Remove(annex);
    }

    private void HandlePostAuditAnnexSelected(InputFileChangeEventArgs e)
    {
        ErrorMessage = null;
        var file = e.File;
        if (file != null)
        {
            try
            {
                ValidateFileFormat(file);
                PendingPostAuditAnnexFile = file;
            }
            catch (Exception ex)
            {
                ErrorMessage = ex.Message;
                PendingPostAuditAnnexFile = null;
            }
        }
    }

    private void DiscardPendingPostAuditAnnex()
    {
        PendingPostAuditAnnexFile = null;
    }

    private async Task AuditPostAuditAnnexImpactAsync()
    {
        if (PendingPostAuditAnnexFile == null || string.IsNullOrWhiteSpace(OriginalContractText)) return;

        using var timerCts = new CancellationTokenSource();
        try
        {
            IsProcessing = true;
            ErrorMessage = null;
            ElapsedSeconds = 0;
            ProcessingProgress = 15;

            _ = Task.Run(async () =>
            {
                try
                {
                    while (!timerCts.Token.IsCancellationRequested)
                    {
                        await Task.Delay(1000, timerCts.Token);
                        ElapsedSeconds++;
                        if (ProcessingProgress < 90)
                        {
                            ProcessingProgress = Math.Min(90, ProcessingProgress + 5);
                        }
                        await InvokeAsync(StateHasChanged);
                    }
                }
                catch (OperationCanceledException) { }
            }, timerCts.Token);

            ProcessingStatusMessage = $"Extrayendo contenido de '{PendingPostAuditAnnexFile.Name}'...";
            ProcessingProgress = 30;
            StateHasChanged();

            var newAnnexText = await DocumentReader.ExtractTextAsync(PendingPostAuditAnnexFile);
            AuditConfig.Annexes.Add(new ContractAnnexItem
            {
                FileName = PendingPostAuditAnnexFile.Name,
                Size = PendingPostAuditAnnexFile.Size,
                Text = newAnnexText
            });

            var selectedCountry = AuditConfig.GetSelectedCountry();
            ProcessingStatusMessage = $"Contrastando '{PendingPostAuditAnnexFile.Name}' contra contrato principal ({selectedCountry.Name})...";
            ProcessingProgress = 55;
            StateHasChanged();

            var updatedResult = await GeminiService.AuditDocumentAsync(OriginalContractText, AuditConfig);

            timerCts.Cancel();
            ProcessingStatusMessage = "Actualizando dictamen legal y semáforo de riesgo...";
            ProcessingProgress = 100;
            StateHasChanged();

            await Task.Delay(400);
            AnalysisData = updatedResult;
            PendingPostAuditAnnexFile = null;
            ActiveTab = "summary";
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error al auditar el Otro Sí: {ex.Message}";
        }
        finally
        {
            timerCts.Cancel();
            IsProcessing = false;
            StateHasChanged();
        }
    }

    private void ValidateAndSetFile(IBrowserFile file)
    {
        ValidateFileFormat(file);
        SelectedFile = file;
    }

    private static void ValidateFileFormat(IBrowserFile file)
    {
        var ext = Path.GetExtension(file.Name).ToLowerInvariant();
        if (ext != ".pdf" && ext != ".docx")
        {
            throw new InvalidOperationException("Solo se permiten documentos en formato PDF (.pdf) o Word (.docx).");
        }

        if (file.Size > DocumentReaderService.MaxFileSizeInBytes)
        {
            throw new InvalidOperationException("El archivo excede el tamaño máximo permitido de 15 MB.");
        }
    }

    private void ClearSelectedFile()
    {
        SelectedFile = null;
        OriginalContractText = null;
        AuditConfig.Annexes.Clear();
        ErrorMessage = null;
    }

    private async Task StartAuditAsync()
    {
        if (SelectedFile == null) return;

        using var timerCts = new CancellationTokenSource();
        try
        {
            IsProcessing = true;
            ErrorMessage = null;
            AuditFileName = SelectedFile.Name;
            ElapsedSeconds = 0;
            ProcessingProgress = 12;

            _ = Task.Run(async () =>
            {
                try
                {
                    while (!timerCts.Token.IsCancellationRequested)
                    {
                        await Task.Delay(1000, timerCts.Token);
                        ElapsedSeconds++;
                        if (ProcessingProgress < 92)
                        {
                            ProcessingProgress = Math.Min(92, ProcessingProgress + (ProcessingProgress < 60 ? 4 : 2));
                        }
                        await InvokeAsync(StateHasChanged);
                    }
                }
                catch (OperationCanceledException) { }
            }, timerCts.Token);

            ProcessingStatusMessage = "Extrayendo y sanitizando el texto del documento principal...";
            ProcessingProgress = 25;
            StateHasChanged();

            OriginalContractText = await DocumentReader.ExtractTextAsync(SelectedFile);

            var selectedCountry = AuditConfig.GetSelectedCountry();
            var perspectiveName = AuditConfig.Perspective == AuditPerspective.Worker ? "Trabajador" : "Empresa";
            var annexNote = AuditConfig.Annexes.Count > 0 ? $" con {AuditConfig.Annexes.Count} Otro Sí" : "";
            ProcessingStatusMessage = $"Auditoría legal con Google Gemini ({selectedCountry.Name} - {perspectiveName}{annexNote})...";
            ProcessingProgress = Math.Max(ProcessingProgress, 45);
            StateHasChanged();

            var result = await GeminiService.AuditDocumentAsync(OriginalContractText, AuditConfig);

            timerCts.Cancel();
            ProcessingStatusMessage = "Consolidando métricas, alertas y contrapropuestas...";
            ProcessingProgress = 100;
            StateHasChanged();

            await Task.Delay(500);
            AnalysisData = result;
            ActiveTab = "summary";
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            timerCts.Cancel();
            IsProcessing = false;
            StateHasChanged();
        }
    }

    private void ResetAnalysis()
    {
        AnalysisData = null;
        SelectedFile = null;
        OriginalContractText = null;
        AuditConfig.Annexes.Clear();
        PendingPostAuditAnnexFile = null;
        ErrorMessage = null;
        ActiveTab = "summary";
        ElapsedSeconds = 0;
        ProcessingProgress = 0;
    }
}
