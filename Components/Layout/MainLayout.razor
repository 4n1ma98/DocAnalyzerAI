@inherits LayoutComponentBase
@inject IJSRuntime JS

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <span class="badge badge-gold px-2 py-1 small">
                    <i class="bi bi-bank2 me-1"></i> LEX AUDIT INTELLIGENCE
                </span>
                <span class="text-muted small d-none d-md-inline">
                    &bull; Auditoría confidencial bajo jurisprudencia vigente
                </span>
            </div>

            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 small d-none d-sm-inline">
                    <i class="bi bi-cpu me-1"></i> Google Gemini
                </span>

                <!-- Botón de Alternar Modo Oscuro / Claro (solo icono, sin texto) -->
                <button type="button"
                        class="btn theme-toggle-btn" 
                        id="themeToggleBtn"
                        onclick="docAnalyzer.toggleTheme()" 
                        title="Alternar entre modo oscuro y claro"
                        aria-label="Alternar modo oscuro o claro">
                    <i class="bi bi-moon-stars-fill" id="themeToggleIcon"></i>
                </button>
            </div>
        </div>

        <article class="content px-3 px-md-4 py-3">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Se ha producido un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("docAnalyzer.syncThemeUI");
            }
            catch { }
        }
    }
}
